@model Uc_10_Wendel_StudyCards.Models.Baralho

<div class="delete-box">

    <h1>Excluir Baralho</h1>

    <div class="delete-warning">
        Tem certeza que deseja excluir este baralho?
    </div>

    @if (!string.IsNullOrEmpty(Model.ImagemUrl))
    {
        <img src="@Model.ImagemUrl"
             alt="@Model.Nome"
             class="baralho-img" />
    }

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="BaralhoId" />

        <div class="entity-actions">

            <button type="submit"
                    class="btn btn-danger">
                Excluir
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>
@model Uc_10_Wendel_StudyCards.Models.Baralho

<div class="baralho-details">

    @if (!string.IsNullOrEmpty(Model.ImagemUrl))
    {
        <img src="@Model.ImagemUrl"
             alt="@Model.Nome"
             class="baralho-img" />
    }

    <h1>@Model.Nome</h1>

    <p>@Model.Descricao</p>

    <div class="details-meta">

        <span>
            Matéria: @Model.Materia?.Nome
        </span>

        <span>
            Categoria: @Model.Categoria?.Nome
        </span>

    </div>

    <div class="entity-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.BaralhoId"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.BaralhoId"
           class="btn btn-danger">
            Excluir
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>
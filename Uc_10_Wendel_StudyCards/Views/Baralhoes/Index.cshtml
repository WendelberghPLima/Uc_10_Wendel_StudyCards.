@model IEnumerable<Uc_10_Wendel_StudyCards.Models.Baralho>

<div class="page-header">

    <h1>Baralhos</h1>

    <a asp-action="Create"
       class="btn btn-primary">

        + Novo Baralho

    </a>

</div>

<form asp-action="Index" method="get">

    <div class="input-group mb-3">

        <input type="text"
               class="form-control"
               placeholder="Pesquisar baralho"
               name="searchString"
               value="@ViewData["CurrentFilter"]" />

        <button class="btn btn-primary"
                type="submit">
            Pesquisar
        </button>

    </div>

</form>

<div class="cards-grid">

    @foreach (var item in Model)
    {
        <div class="baralho-card">

        <img src="@(string.IsNullOrEmpty(item.ImagemUrl) ? "~/imagens/baralho-padrao.jpg" : item.ImagemUrl)"
             class="card-image"
             alt="@item.Nome" />

        <div class="custom-card-body">

            <h3>@item.Nome</h3>

            <p>@item.Descricao</p>

            <div class="baralho-meta">

                <span>
                    📚 @item.Materia?.Nome
                </span>

                <span>
                    🏷 @item.Categoria?.Nome
                </span>

            </div>

            <div class="entity-actions">

                <a asp-action="Details"
                   asp-route-id="@item.BaralhoId"
                   class="btn btn-outline-primary">

                    Detalhes

                </a>

                <a asp-action="Cards"
                   asp-route-id="@item.BaralhoId"
                   class="btn btn-outline-secondary">

                    Cards

                </a>

                <a asp-action="Estudar"
                   asp-route-id="@item.BaralhoId"
                   class="btn btn-success">

                    Estudar

                </a>

            </div>

        </div>

    </div>
    }

</div>
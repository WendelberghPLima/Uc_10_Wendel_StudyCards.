@model Uc_10_Wendel_StudyCards.Models.Card

<div class="delete-box">

    <h1>Excluir Card</h1>

    <div class="delete-warning">
        Tem certeza que deseja excluir este card?
    </div>

    <h3>@Model.Pergunta</h3>

    <p>
        <strong>Resposta:</strong>
        @Model.Resposta
    </p>

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="CardId" />

        <div class="entity-actions">

            <button type="submit"
                    class="btn btn-danger">
                Excluir
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>
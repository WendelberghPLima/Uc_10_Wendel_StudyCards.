@model Uc_10_Wendel_StudyCards.Models.Card

<div class="baralho-details">

    <h1>Visualização do Card</h1>

    <div class="details-section">

        <h4>Pergunta</h4>

        <div class="details-description">
            @Model.Pergunta
        </div>

    </div>

    <div class="details-section">

        <h4>Resposta</h4>

        <div class="details-description">
            @Model.Resposta
        </div>

    </div>

    <div class="details-meta">

        <span>
            Baralho:
            @Model.Baralho?.Nome
        </span>

        <span>
            Dificuldade:
            @Model.Dificuldade?.Nome
        </span>

        <span>
            Criado em:
            @Model.DataCriacao.ToString("dd/MM/yyyy")
        </span>

    </div>

    <div class="entity-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.CardId"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.CardId"
           class="btn btn-danger">
            Excluir
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>
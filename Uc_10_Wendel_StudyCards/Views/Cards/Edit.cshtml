@model Uc_10_Wendel_StudyCards.Models.Card

<div class="page-header">
    <h1>Editar Card</h1>
</div>

<div class="baralho-details">

    <form asp-action="Edit">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="CardId" />

        <div class="mb-3">
            <label asp-for="Pergunta" class="form-label"></label>
            <textarea asp-for="Pergunta"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Resposta" class="form-label"></label>
            <textarea asp-for="Resposta"
                      class="form-control"
                      rows="6"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="BaralhoId" class="form-label"></label>
            <select asp-for="BaralhoId"
                    asp-items="ViewBag.BaralhoId"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="DificuldadeId" class="form-label"></label>
            <select asp-for="DificuldadeId"
                    asp-items="ViewBag.DificuldadeId"
                    class="form-select">
            </select>
        </div>

        <div class="entity-actions">

            <button type="submit"
                    class="btn btn-warning">
                Atualizar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>

    </form>

</div>
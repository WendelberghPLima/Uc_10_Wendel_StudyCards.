@model Uc_10_Wendel_StudyCards.Models.Categoria

<div class="baralho-details">

    <h1>@Model.Nome</h1>

    <p>@Model.Descricao</p>

    <div class="entity-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.CategoriaId"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.CategoriaId"
           class="btn btn-danger">
            Excluir
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Voltar
        </a>

    </div>

</div>
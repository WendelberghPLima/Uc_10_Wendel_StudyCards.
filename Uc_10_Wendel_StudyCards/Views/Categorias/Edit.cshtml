@model Uc_10_Wendel_StudyCards.Models.Categoria

<div class="page-header">
    <h1>Editar Categoria</h1>
</div>

<div class="baralho-details">
    <form asp-action="Edit">

        <input type="hidden" asp-for="CategoriaId" />

        <div class="mb-3">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label"></label>
            <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
        </div>

        <div class="entity-actions">
            <button type="submit" class="btn btn-warning">Atualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>

    </form>
</div>
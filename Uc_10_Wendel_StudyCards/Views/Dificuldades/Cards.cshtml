@model Uc_10_Wendel_StudyCards.Models.Dificuldade

<h1>
    Cards @Model.Nome
</h1>

<div class="cards-list">

    @foreach (var item in Model.Cards)
    {
        <div class="card-item">

            <div class="card-item-info">

                <h5>
                    @item.Pergunta
                </h5>

            </div>

        </div>
    }

</div>

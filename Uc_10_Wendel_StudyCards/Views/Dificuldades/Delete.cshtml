@model Uc_10_Wendel_StudyCards.Models.Dificuldade

<div class="delete-box">

    <h1>Excluir Dificuldade</h1>

    <div class="delete-warning">

        <p>
            Tem certeza que deseja excluir esta dificuldade?
        </p>

    </div>

    <h3>@Model.Nome</h3>

    <form asp-action="Delete">

        <input type="hidden"
               asp-for="DificuldadeId" />

        <div class="entity-actions">

            <button type="submit"
                    class="btn btn-danger">
                Excluir
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>
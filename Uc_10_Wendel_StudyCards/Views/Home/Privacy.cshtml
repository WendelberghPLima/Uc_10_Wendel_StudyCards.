@{
    ViewData["Title"] = "Sobre";
}

<div class="baralho-details">

    <h1>Sobre o StudyCards</h1>

    <p class="details-description">

        O StudyCards é uma plataforma de estudos baseada em flashcards,
        desenvolvida para auxiliar estudantes na revisão e memorização
        de conteúdos de forma prática e organizada.

        O sistema permite cadastrar matérias, categorias, baralhos,
        dificuldades e cards personalizados, facilitando o aprendizado
        através da repetição e da prática constante.

    </p>

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <h2>📚</h2>
            <p>Organização de Conteúdos</p>
        </div>

        <div class="dashboard-card">
            <h2>🧠</h2>
            <p>Memorização Eficiente</p>
        </div>

        <div class="dashboard-card">
            <h2>🎯</h2>
            <p>Aprendizado Personalizado</p>
        </div>

    </div>

    <div class="mt-4">

        <h3>Objetivo</h3>

        <p>
            Este projeto foi desenvolvido para a Unidade Curricular de
            Desenvolvimento de Sistemas, aplicando conceitos de
            ASP.NET MVC, Entity Framework e Banco de Dados Relacional.
        </p>

    </div>

</div>
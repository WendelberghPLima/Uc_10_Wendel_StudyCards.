@model Uc_10_Wendel_StudyCards.Models.Materia

@{
    ViewData["Title"] = "Baralhos";
}

<div class="page-header">

    <h1>
        Baralhos de @Model.Nome
    </h1>

</div>

<div class="cards-grid">

    @foreach (var item in Model.Baralhos)
    {
        <div class="baralho-card">

            <div class="custom-card-body">

                <h3>@item.Nome</h3>

                <p>@item.Descricao</p>

                <div class="entity-actions">

                    <a asp-controller="Baralhoes"
                       asp-action="Details"
                       asp-route-id="@item.BaralhoId"
                       class="btn btn-primary">

                        Ver Baralho

                    </a>

                </div>

            </div>

        </div>
    }

</div>